# Supabase Auth + database (server-only secret stays private)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe server secret; never expose to the browser
STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# AI Gateway is zero-config on Vercel; demo mode works without deployment settings
AI_MODEL=openai/gpt-5.5
AI_MATCHING_PROVIDER=gateway
AI_MATCHING_MODEL=

# Rate limiting provider (optional in local demo mode)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
